# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Public base URL of this service (e.g. ngrok URL during dev, Render/Fly URL in prod)
# Used to build the ConversationRelay websocket URL and TwiML callback URLs.
PUBLIC_BASE_URL=https://your-tunnel-or-deployed-url

# Groq (conversation LLM + post-call extraction)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Sarvam AI (Hindi/Hinglish STT+TTS) - wired in for the vernacular demo call, optional for English-only runs
SARVAM_API_KEY=
# Sarvam STT needs the <Record> TwiML verb, which some Twilio accounts (trial/child accounts)
# reject outright. Leave false unless you've confirmed <Record> works on your account -- Sarvam
# TTS (the voice you hear) works independently of this and is always used when SARVAM_API_KEY is set.
ENABLE_SARVAM_STT=false

# WhatsApp Cloud API
WHATSAPP_CLOUD_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Supabase (service_role key -- NOT the anon key. Project Settings -> API -> service_role secret.
# Backend bypasses RLS since it writes via Twilio webhooks, not a logged-in user.)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Demo parent to call when hitting POST /demo/call (must be Twilio-verified while on trial)
DEMO_PARENT_PHONE_NUMBER=

# Shared secret the dashboard sends to trigger a real call -- generate with:
# python3 -c "import secrets; print(secrets.token_urlsafe(32))"
INTERNAL_API_KEY=
