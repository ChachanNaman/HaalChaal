# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Public base URL of this service (e.g. ngrok URL during dev, Render/Fly URL in prod)
# Used to build the ConversationRelay websocket URL and TwiML callback URLs.
PUBLIC_BASE_URL=https://your-tunnel-or-deployed-url

# Groq (conversation LLM + post-call extraction)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Sarvam AI (Hindi/Hinglish STT+TTS) - wired in for the vernacular demo call, optional for English-only runs
SARVAM_API_KEY=

# WhatsApp Cloud API
WHATSAPP_CLOUD_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Demo parent to call when hitting POST /demo/call (must be Twilio-verified while on trial)
DEMO_PARENT_PHONE_NUMBER=
